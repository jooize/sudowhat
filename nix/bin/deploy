#!/usr/bin/env bash
# deploy -- bump the nix-darwin flake's pin of this repo to the latest release
# tag and rebuild.
#
# Interactive sibling of deploy-plan: instead of only printing the commands, it
# shows the exact commands that will run as root, asks for confirmation, and
# executes them via sudo. Use deploy-plan for copy-paste output only.
#
# sudowhat is pinned by release tag AND rev (ref=refs/tags/vX.Y.Z&rev=<sha>), so
# this bumps BOTH to the latest release tag reachable from HEAD -- never a raw,
# untagged HEAD. It refuses a dirty tree (uncommitted changes are in no tag).
set -euo pipefail
IFS=$'\n\t'

usage() {
  cat <<'EOF'
usage: deploy [--yes] [--dry-run] [-h|--help]

Bumps the sudowhat input in the nix-darwin flake to the latest release tag
reachable from HEAD (ref=refs/tags/vX.Y.Z + rev), then runs darwin-rebuild.
Both steps run under sudo, after showing the exact commands and confirming.

  --yes      skip the confirmation prompt (still prints the commands)
  --dry-run  print the commands, run nothing

Env:
  NIX_DARWIN_FLAKE   path to the system flake (default /etc/nix-darwin/flake.nix)
EOF
}

# Color per stream, each gated on the fd it is written to: C_* for stdout
# (the header rows, the command lines, the question and its answer lines),
# E_* for stderr (the refusals). Piping or redirecting one stream keeps it
# free of escape bytes without stripping the other. NO_COLOR
# (https://no-color.org) turns both off. Every refusal is a verdict: red, led
# by its glyph, U+2717, written as its UTF-8 bytes (\xe2\x9c\x97) in the printf
# formats like the U+2713 verdicts.
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  C_OFF=$'\033[0m'; C_B=$'\033[1m'; C_DIM=$'\033[2m'
  C_GRN=$'\033[32m'; C_YEL=$'\033[33m'; C_CYN=$'\033[36m'
  C_BLU=$'\033[1;34m'
else
  C_OFF=; C_B=; C_DIM=; C_GRN=; C_YEL=; C_CYN=; C_BLU=
fi
if [[ -t 2 && -z "${NO_COLOR:-}" ]]; then
  E_OFF=$'\033[0m'; E_DIM=$'\033[2m'; E_RED=$'\033[31m'; E_HID=$'\033[7;31m'
else
  E_OFF=; E_DIM=; E_RED=; E_HID=
fi

# Text someone else wrote (here: an argument) is shown by the house
# untrusted-text rules, the same ones escape_core applies to sudo's argv: a
# code point on the hidden list shows as \u{HEX} wrapped in <on>..<off> (the
# reserved reverse red on a terminal), a byte that is not valid UTF-8 as \xHH,
# a backslash that would begin an escape (before "u{", or before "x" and a hex
# digit) as \u{5C}, and every other character as itself. Works on the bytes
# (LC_ALL=C), decoding UTF-8 by hand so only the bytes that fail are escaped.
# Bash 3.2 reads a high byte as a negative number, hence the +256.
is_hidden() { # <code point>
  local u=$1
  (( u <= 0x1F || (u >= 0x7F && u <= 0x9F) || u == 0xA0 || u == 0xAD
     || u == 0x34F || u == 0x61C || (u >= 0x115F && u <= 0x1160)
     || (u >= 0x17B4 && u <= 0x17B5) || (u >= 0x180B && u <= 0x180E)
     || (u >= 0x2000 && u <= 0x200F) || (u >= 0x2028 && u <= 0x202F)
     || (u >= 0x205F && u <= 0x206F) || u == 0x3000 || u == 0x3164
     || (u >= 0xFE00 && u <= 0xFE0F) || u == 0xFEFF || u == 0xFFA0
     || (u >= 0xFFF9 && u <= 0xFFFB) || (u >= 0xE0000 && u <= 0xE007F)
     || (u >= 0xE0100 && u <= 0xE01EF) ))
}
escape_untrusted() { # <text> <on> <off>
  local LC_ALL=C
  local s=$1 on=$2 off=$3 out='' c i=0 n b nb cp len min k
  n=${#s}
  while (( i < n )); do
    printf -v b '%d' "'${s:i:1}"
    (( b < 0 )) && b=$((b + 256))
    len=0 cp=0 min=0
    if (( b < 0x80 )); then len=1 cp=$b
    elif (( b >= 0xC2 && b <= 0xDF )); then len=2 cp=$((b & 0x1F)) min=0x80
    elif (( b >= 0xE0 && b <= 0xEF )); then len=3 cp=$((b & 0x0F)) min=0x800
    elif (( b >= 0xF0 && b <= 0xF4 )); then len=4 cp=$((b & 0x07)) min=0x10000
    fi
    k=1
    while (( k < len )); do
      if (( i + k >= n )); then len=0; break; fi
      printf -v nb '%d' "'${s:i+k:1}"
      (( nb < 0 )) && nb=$((nb + 256))
      if (( nb < 0x80 || nb > 0xBF )); then len=0; break; fi
      cp=$(( (cp << 6) | (nb & 0x3F) ))
      k=$((k + 1))
    done
    if (( len > 1 && (cp < min || (cp >= 0xD800 && cp <= 0xDFFF) || cp > 0x10FFFF) )); then
      len=0
    fi
    if (( len == 0 )); then
      printf -v c '\\x%02X' "$b"
      out+=$c
      i=$((i + 1))
      continue
    fi
    if is_hidden "$cp"; then
      printf -v c '%s\\u{%X}%s' "$on" "$cp" "$off"
    elif (( cp == 0x5C )) && [[ "${s:i+1:2}" == 'u{' || "${s:i+1:2}" == x[0-9A-Fa-f] ]]; then
      c='\u{5C}'
    else
      c=${s:i:len}
    fi
    out+=$c
    i=$((i + len))
  done
  printf '%s' "$out"
}

YES=0 DRY_RUN=0
for arg in "$@"; do
  case "$arg" in
    --yes) YES=1 ;;
    --dry-run) DRY_RUN=1 ;;
    -h|--help) usage; exit 0 ;;
    *) printf '%s\xe2\x9c\x97 error: unknown argument: %s%s\n' "$E_RED" \
         "$(escape_untrusted "$arg" "$E_HID" "$E_OFF$E_RED")" "$E_OFF" >&2
       usage >&2; exit 1 ;;
  esac
done

# macOS-only project (Touch ID / LAContext sudo plugin): the system flake is
# always nix-darwin. NIX_DARWIN_FLAKE overrides the path.
FLAKE="${NIX_DARWIN_FLAKE:-/etc/nix-darwin/flake.nix}"
REPO_MATCH='sudowhat?ref='   # identifies this repo's input line in the flake

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  printf '%s\xe2\x9c\x97 error: not inside a git repository%s\n' "$E_RED" "$E_OFF" >&2
  exit 1
}
cd "${repo_root}" || exit 1

# Refuse a dirty tree: uncommitted changes are in no tag, so a deploy would
# misrepresent what is actually running.
if ! git diff --quiet || ! git diff --cached --quiet; then
  {
    printf '%s\xe2\x9c\x97 error: working tree is dirty -- uncommitted changes are in no release tag%s\n' \
      "$E_RED" "$E_OFF"
    printf '%s         commit and tag a release, or stash, before deploying:%s\n' "$E_DIM" "$E_OFF"
    # --untracked-files=no: list only what actually tripped the refusal (tracked,
    # staged-or-unstaged modifications). Untracked files do not affect the tagged
    # build, so showing them here would only mislead.
    git status --short --untracked-files=no | sed 's/^/           /'
  } >&2
  exit 1
fi

head="$(git rev-parse HEAD)"

# Deploy target = latest release tag reachable from HEAD (highest semver).
target_tag="$(git tag --merged HEAD 2>/dev/null | grep -E '^v[0-9]' | sort -V | tail -n1 || true)"
[[ -n "${target_tag}" ]] || {
  printf '%s\xe2\x9c\x97 error: no release tag (vX.Y.Z) reachable from HEAD -- tag a release first%s\n' \
    "$E_RED" "$E_OFF" >&2
  exit 1
}
target_rev="$(git rev-list -n1 "${target_tag}")"

# The tagged release's declared version, for a tag/version consistency check.
tag_version="$(git show "${target_tag}:nix/package.nix" 2>/dev/null \
  | grep -oE 'version *= *"[0-9.]+"' | head -n1 | grep -oE '[0-9]+(\.[0-9]+)*' || true)"

[[ -r "${FLAKE}" ]] || {
  printf '%s\xe2\x9c\x97 error: cannot read the flake (set NIX_DARWIN_FLAKE to name another): %s%s\n' \
    "$E_RED" "${FLAKE}" "$E_OFF" >&2
  exit 1
}
pin_line="$(grep -F "${REPO_MATCH}" "${FLAKE}" | head -n1 || true)"
[[ -n "${pin_line}" ]] || {
  printf '%s\xe2\x9c\x97 error: no sudowhat input pin in the flake: %s%s\n' \
    "$E_RED" "${FLAKE}" "$E_OFF" >&2
  exit 1
}
# Match ANY current ref (a release tag OR a branch, e.g. a hardware-test pin),
# plus the rev. The whole ref= token is swapped to the target tag ref.
pin_ref_kv="$(printf '%s\n' "${pin_line}" | grep -oE 'ref=[^&"]+' | head -n1 || true)"
pinned_rev="$(printf '%s\n' "${pin_line}" | grep -oE 'rev=[0-9a-f]{40}' | head -n1 | cut -d= -f2 || true)"
[[ -n "${pinned_rev}" ]] || {
  printf '%s\xe2\x9c\x97 error: no rev= pin for sudowhat in the flake: %s%s\n' \
    "$E_RED" "${FLAKE}" "$E_OFF" >&2
  exit 1
}

# Header. Each row leads with what is fixed-width (the label, a 10-char rev)
# and ends with the one value whose length git or the flake chooses (a tag, a
# ref, a path), so nothing follows such a value on its line; the flake path
# takes a row of its own. Same facts as deploy-plan's header. Field labels are
# lowercase and bold (HEAD is git's own name for it); the gutter is the longest
# label plus two spaces. C_DIM is the dim ATTRIBUTE and does not reset the
# foreground, so reset with C_OFF before each colour switch or it bleeds.
print_header() {
  printf '%starget:%s  %s%s%s  %s%s%s\n' \
    "$C_B" "$C_OFF" "$C_CYN" "${target_rev:0:10}" "$C_OFF" \
    "$C_CYN" "${target_tag}" "$C_OFF"
  printf '%sHEAD:%s    %s%s%s' "$C_B" "$C_OFF" "$C_CYN" "${head:0:10}" "$C_OFF"
  if [[ "${head}" == "${target_rev}" ]]; then
    printf '  %s(%sat the target%s)%s\n' "$C_DIM" "$C_OFF$C_GRN" "$C_OFF$C_DIM" "$C_OFF"
  else
    local ahead
    ahead="$(git rev-list --count "${target_rev}..HEAD" 2>/dev/null || echo '?')"
    printf '  %s(%s%s commit(s) after the target -- unreleased%s)%s\n' \
      "$C_DIM" "$C_OFF$C_YEL" "${ahead}" "$C_OFF$C_DIM" "$C_OFF"
  fi
  printf '%spinned:%s  %s%s%s  %s%s%s\n' \
    "$C_B" "$C_OFF" "$C_CYN" "${pinned_rev:0:10}" "$C_OFF" \
    "$C_DIM" "${pin_ref_kv:-ref=?}" "$C_OFF"
  printf '%sflake:%s   %s%s%s\n' "$C_B" "$C_OFF" "$C_CYN" "${FLAKE}" "$C_OFF"
  if [[ -n "${tag_version}" && "${target_tag}" != "v${tag_version}" ]]; then
    printf '%swarning: nix/package.nix at the target tag declares version %s%s\n' \
      "$C_YEL" "${tag_version}" "$C_OFF"
  fi
  printf '\n'
}

if [[ "${pinned_rev}" == "${target_rev}" ]]; then
  print_header
  printf '%s\xe2\x9c\x93 already in sync%s\n' "$C_GRN" "$C_OFF"
  exit 0
fi

# Off a terminal there is nobody to answer the question, so the run refuses
# here, before any row: the header and the command lines are the question's
# rows, and a refusal prints none (terminal-output). --dry-run asks nothing,
# and --yes has answered already.
if (( ! DRY_RUN && ! YES )) && [[ ! -t 0 ]]; then
  printf '%s\xe2\x9c\x97 error: no tty for confirmation -- pass --yes to proceed non-interactively%s\n' \
    "$E_RED" "$E_OFF" >&2
  exit 2
fi

# Literal ref+rev swap via perl. \Q..\E quotemeta-escapes the pattern (so the
# dots in a version match literally); s{}{} bracket delimiters avoid clashing
# with the slashes in refs/tags and sidestep the literal `&` between ref and rev
# that a sed s|..&..| form would need escaped. Only rewrite ref if one was found.
subst="s{\\Q${pin_ref_kv}\\E}{ref=refs/tags/${target_tag}}g; s{\\Qrev=${pinned_rev}\\E}{rev=${target_rev}}g"
[[ -n "${pin_ref_kv}" ]] || subst="s{\\Qrev=${pinned_rev}\\E}{rev=${target_rev}}g"
# One command line under sudo, drawn the way terminal-output draws a command
# line: the leading sudo bold (it marks where root begins), the program bold
# blue, every token that starts with '-' bold blue (a lexical mark, never a
# judgement about the flag), every other argument plain. Built from the argv
# array itself, one %q-quoted token at a time, so the marks follow the parts
# and the line stays the command that runs. Both programs here are bare
# names, which take the bold blue whole.
print_command() { # <program> [args...]
  local tok q
  printf -v q '%q' "$1"
  printf '  %ssudo%s %s%s%s' "$C_B" "$C_OFF" "$C_BLU" "${q}" "$C_OFF"
  shift
  for tok in "$@"; do
    printf -v q '%q' "${tok}"
    if [[ "${q}" == -* ]]; then
      printf ' %s%s%s' "$C_BLU" "${q}" "$C_OFF"
    else
      printf ' %s' "${q}"
    fi
  done
  printf '\n'
}

PIN_CMD=(perl -i -pe "${subst}" -- "${FLAKE}")
REBUILD_CMD=(darwin-rebuild switch --flake "$(dirname "${FLAKE}")")

# With --yes these rows are the record of what ran; otherwise they are the
# question's rows. No label above the two command lines: the question names
# them ("the lines above"), they count as its rows, and nothing but the
# gate's blank line stands between them and it. The leading sudo already
# says where root begins.
print_header
print_command "${PIN_CMD[@]}"
print_command "${REBUILD_CMD[@]}"
printf '\n'

if (( DRY_RUN )); then
  printf '%sDry run -- nothing executed.%s\n' "$C_YEL" "$C_OFF"
  exit 0
fi

# A decline is a normal outcome with its own quiet line: yellow, the verb for
# a [y/N] answered after looking, and what stays as it was. Exit 2.
decline() {
  printf '%saborted; flake pin unchanged%s\n' "$C_YEL" "$C_OFF"
  exit 2
}

if (( ! YES )); then
  # One verb and its noun, holding no value: the commands it decides about
  # are the lines directly above it. Bold carries the sentence; the two keys
  # are bold blue, each re-opening bold after its reset. The answer is typed
  # at the end of the question line, after one space.
  printf -v question '%srun the lines above? [%sy%s%s/%sN%s%s]%s ' \
    "$C_B" "$C_BLU" "$C_OFF" "$C_B" "$C_BLU" "$C_OFF" "$C_B" "$C_OFF"
  printf '%s' "${question}"
  while :; do
    # End of input never acts: a closed terminal is not an answer. The
    # cursor still waits on the question line, so end it first.
    if ! IFS= read -r answer; then
      printf '\n'
      decline
    fi
    case "${answer}" in
      y|Y|yes|YES) break ;;
      ''|n|N|no|NO) decline ;;
    esac
    # Anything else is not acted on: say so, never echo what was typed (a
    # pasted control sequence printed raw could rewrite the question), and
    # ask again on a fresh question line.
    printf '%snot an answer%s\n%s' "$C_YEL" "$C_OFF" "${question}"
  done
fi

# The verdict leads with the fixed-width rev and ends with the tag, the same
# order as the target row.
sudo "${PIN_CMD[@]}"
printf '%s\xe2\x9c\x93 pin updated: %s  %s%s\n' "$C_GRN" "${target_rev:0:10}" "${target_tag}" "$C_OFF"
sudo "${REBUILD_CMD[@]}"
printf '%s\xe2\x9c\x93 rebuild complete%s\n' "$C_GRN" "$C_OFF"
