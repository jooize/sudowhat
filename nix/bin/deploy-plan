#!/usr/bin/env bash
# deploy-plan -- print the exact commands to deploy this repo via nix-darwin.
#
# sudowhat is pinned in the nix-darwin flake by release tag AND rev:
#   sudowhat.url = "git+file://.../sudowhat?ref=refs/tags/vX.Y.Z&rev=<sha>";
# The pin tracks tagged releases, so deploying a change means bumping BOTH the
# tag ref and the rev to the latest release tag, then rebuilding. This script
# does NOT mutate /etc or run darwin-rebuild (surface-the-command policy): it
# reads the latest release tag, the pinned ref/rev, and HEAD, then prints
# copy-paste-ready commands with the new values already filled in.
set -euo pipefail
IFS=$'\n\t'
shopt -s nullglob

# Color per stream, each gated on the fd it is written to: C_* for stdout,
# E_* for stderr (the errors), so piping or redirecting one stream keeps it
# free of escape bytes without stripping the other. NO_COLOR
# (https://no-color.org) turns both off. Each error is a verdict: red, led by
# its glyph, U+2717, written as its UTF-8 bytes (\xe2\x9c\x97) in the printf
# formats like the U+2713 verdict.
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  C_OFF=$'\033[0m'; C_B=$'\033[1m'; C_DIM=$'\033[2m'
  C_RED=$'\033[31m'; C_GRN=$'\033[32m'; C_YEL=$'\033[33m'; C_CYN=$'\033[36m'
  C_BLU=$'\033[1;34m'
else
  C_OFF=; C_B=; C_DIM=; C_RED=; C_GRN=; C_YEL=; C_CYN=; C_BLU=
fi
if [[ -t 2 && -z "${NO_COLOR:-}" ]]; then
  E_OFF=$'\033[0m'; E_RED=$'\033[31m'
else
  E_OFF=; E_RED=
fi

case "${1:-}" in
  -h|--help)
    cat <<'EOF'
deploy-plan -- print the commands to deploy this repo via nix-darwin.

Reads the latest release tag, the rev pinned in the nix-darwin flake, and HEAD,
then prints copy-paste-ready sed + darwin-rebuild commands. Mutates nothing.

Env:
  NIX_DARWIN_FLAKE   path to the system flake (default /etc/nix-darwin/flake.nix)
EOF
    exit 0
    ;;
esac

# macOS-only project (Touch ID / LAContext sudo plugin): the system flake is
# always nix-darwin, edited with BSD sed. NIX_DARWIN_FLAKE overrides the path.
FLAKE="${NIX_DARWIN_FLAKE:-/etc/nix-darwin/flake.nix}"
REPO_MATCH='sudowhat?ref='   # identifies this repo's input line in the flake

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  printf '%s\xe2\x9c\x97 error: not inside a git repository%s\n' "$E_RED" "$E_OFF" >&2
  exit 1
}
cd "${repo_root}" || exit 1

head="$(git rev-parse HEAD)"

# Deploy target = latest release tag reachable from HEAD (highest semver).
target_tag="$(git tag --merged HEAD 2>/dev/null | grep -E '^v[0-9]' | sort -V | tail -n1 || true)"
if [[ -z "${target_tag}" ]]; then
  printf '%s\xe2\x9c\x97 error: no release tag (vX.Y.Z) reachable from HEAD -- tag a release first%s\n' \
    "$E_RED" "$E_OFF" >&2
  exit 1
fi
target_rev="$(git rev-list -n1 "${target_tag}")"

# The tagged release's declared version, for a tag/version consistency check.
tag_version="$(git show "${target_tag}:nix/package.nix" 2>/dev/null \
  | grep -oE 'version *= *"[0-9.]+"' | head -n1 | grep -oE '[0-9]+(\.[0-9]+)*' || true)"

dirty=0
if ! git diff --quiet || ! git diff --cached --quiet; then
  dirty=1
fi

pinned_rev=""
pinned_ref=""
if [[ -r "${FLAKE}" ]]; then
  pin_line="$(grep -F "${REPO_MATCH}" "${FLAKE}" 2>/dev/null | head -n1 || true)"
  if [[ -n "${pin_line}" ]]; then
    pinned_rev="$(printf '%s\n' "${pin_line}" | grep -oE 'rev=[0-9a-f]{40}' | head -n1 | cut -d= -f2 || true)"
    # Match ANY current ref (a release tag OR a branch, e.g. a hardware-test
    # pin), so the emitted sed swaps the whole ref= token to the target tag ref
    # instead of falling back to the manual "edit the flake" note.
    pinned_ref="$(printf '%s\n' "${pin_line}" | grep -oE 'ref=[^&"]+' | head -n1 | cut -d= -f2 || true)"
  fi
fi

ahead="$(git rev-list --count "${target_rev}..HEAD" 2>/dev/null || echo '?')"

# Header, the same rows as deploy's. Each row leads with what is fixed-width
# (the label, a 10-char rev) and ends with the one value whose length git or
# the flake chooses (a tag, a ref, a path), so nothing follows such a value on
# its line; the flake path takes a row of its own. Field labels are lowercase
# and bold (HEAD is git's own name for it). C_DIM is the dim ATTRIBUTE and does
# not reset the foreground, so reset with C_OFF before each colour switch, else
# it bleeds into the parens.
printf '%starget:%s  %s%s%s  %s%s%s\n' \
  "$C_B" "$C_OFF" "$C_CYN" "${target_rev:0:10}" "$C_OFF" \
  "$C_CYN" "${target_tag}" "$C_OFF"
printf '%sHEAD:%s    %s%s%s' "$C_B" "$C_OFF" "$C_CYN" "${head:0:10}" "$C_OFF"
if [[ "${head}" == "${target_rev}" ]]; then
  printf '  %s(%sat the target%s)%s\n' "$C_DIM" "$C_OFF$C_GRN" "$C_OFF$C_DIM" "$C_OFF"
else
  printf '  %s(%s%s commit(s) after the target -- unreleased%s)%s\n' \
    "$C_DIM" "$C_OFF$C_YEL" "${ahead}" "$C_OFF$C_DIM" "$C_OFF"
fi
if [[ -n "${pinned_rev}" ]]; then
  printf '%spinned:%s  %s%s%s  %sref=%s%s\n' \
    "$C_B" "$C_OFF" "$C_CYN" "${pinned_rev:0:10}" "$C_OFF" \
    "$C_DIM" "${pinned_ref:-?}" "$C_OFF"
else
  printf '%spinned:%s  %sunreadable (set NIX_DARWIN_FLAKE to name another flake)%s\n' \
    "$C_B" "$C_OFF" "$C_RED" "$C_OFF"
fi
printf '%sflake:%s   %s%s%s\n' "$C_B" "$C_OFF" "$C_CYN" "${FLAKE}" "$C_OFF"

# Consistency warnings (non-fatal).
if (( dirty )); then
  printf '%swarning: working tree is dirty (uncommitted changes are in no tag):%s\n' \
    "$C_YEL" "$C_OFF"
  # Only tracked, staged-or-unstaged changes (what `dirty` above tests); untracked
  # files do not affect the tagged build.
  git status --short --untracked-files=no | sed 's/^/         /'
fi
if [[ -n "${tag_version}" && "${target_tag}" != "v${tag_version}" ]]; then
  printf '%swarning: nix/package.nix at the target tag declares version %s%s\n' \
    "$C_YEL" "${tag_version}" "$C_OFF"
fi
printf '\n'

if [[ -n "${pinned_rev}" && "${pinned_rev}" == "${target_rev}" ]]; then
  printf '%s\xe2\x9c\x93 already in sync%s\n' "$C_GRN" "$C_OFF"
  exit 0
fi

# One command line under sudo, drawn the way terminal-output draws a command
# line: the leading sudo bold (it marks where root begins), the program bold
# blue, every token that starts with '-' bold blue (a lexical mark, never a
# judgement about the flag), every other argument plain. Built from the argv
# itself, one %q-quoted token at a time, so the marks follow the parts and a
# pasted line is the command shown, a flake path with a space included. Both
# programs here are bare names, which take the bold blue whole. Same helper
# as deploy's.
print_command() { # <program> [args...]
  local tok q
  printf -v q '%q' "$1"
  printf '  %ssudo%s %s%s%s' "$C_B" "$C_OFF" "$C_BLU" "${q}" "$C_OFF"
  shift
  for tok in "$@"; do
    printf -v q '%q' "${tok}"
    if [[ "${q}" == -* ]]; then
      printf ' %s%s%s' "$C_BLU" "${q}" "$C_OFF"
    else
      printf ' %s' "${q}"
    fi
  done
  printf '\n'
}

# A suggestion block keeps its own label (terminal-output). The label names
# no tag: the target row above holds it, and the commands spell it out.
printf '%sTo deploy the target:%s\n' "$C_B" "$C_OFF"
if [[ -n "${pinned_rev}" && -n "${pinned_ref}" ]]; then
  print_command sed -i '' \
    -e "s|ref=${pinned_ref}|ref=refs/tags/${target_tag}|" \
    -e "s|rev=${pinned_rev}|rev=${target_rev}|" "${FLAKE}"
else
  # The flake row names the file; the tag, whose length git does not bound,
  # ends the line.
  printf '  %s# in the flake, set the sudowhat input to rev=%s and ref=refs/tags/%s%s\n' \
    "$C_DIM" "${target_rev}" "${target_tag}" "$C_OFF"
fi
print_command darwin-rebuild switch --flake "$(dirname "${FLAKE}")"
